# Client: base URL of the deployed server (leave empty if the server serves the built site)
VITE_API_URL=

# Server storage: set S3_BUCKET to enable cloud storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# Without it, the server falls back to local disk (server/uploads + server/data/gallery.json).
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required for Cloudflare R2 / Backblaze B2 / MinIO (e.g. https://<account>.r2.cloudflarestorage.com)
S3_ENDPOINT=
# Public URL prefix for images, e.g. https://pub-<hash>.r2.dev (R2 public bucket) or https://<bucket>.s3.amazonaws.com
S3_PUBLIC_BASE=
